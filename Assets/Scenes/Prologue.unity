--- !u!114 &1364468044
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1364468039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50441ece8f98f4bfe9137a9a311bf17c, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::PrologueController
  frames:
  - image: {fileID: 2597844086776013276, guid: 1f7282abe151b4e898ae941665cbbae3, type: 3}
    narration: Another ordinary day at the agency. Eddie keeps his head down.
    zoomFrom: 1
    zoomTo: 1.1
    zoomDuration: 8
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: 233851718628059059, guid: fe10ee364b0ac42458591cacdb8a8aaa, type: 3}
    narration: Chairs empty out one by one. His screen is still open, his list still long.
    zoomFrom: 1
    zoomTo: 1.08
    zoomDuration: 7
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: -3644646592640700851, guid: 95b1830e4b2d240b1825c5b8331ec94a, type: 3}
    narration: Papers everywhere, none of them finished. He sleeps on top of them.
    zoomFrom: 1.02
    zoomTo: 1.1
    zoomDuration: 8
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: -5951117750304132410, guid: 991884038bbc147fb94d96004837c2a4, type: 3}
    narration: He lifts his head. Every chair around him is pushed in and empty.
    zoomFrom: 1.12
    zoomTo: 1
    zoomDuration: 9
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: 6983405604882635748, guid: b3396713022804d009e4576abe0362d1, type: 3}
    narration: The clock on the wall reads midnight. Nobody should still be here.
    zoomFrom: 1
    zoomTo: 1.06
    zoomDuration: 5
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: 3932627825671445155, guid: 2edc19345d2a94a63b200b8c95ab8535, type: 3}
    narration: The ceiling lights cut out. Only the windows are left, and they are grey.
    zoomFrom: 1.1
    zoomTo: 1
    zoomDuration: 9
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: -3457971734771721935, guid: f121dbfbe03d4440c80f859869733c23, type: 3}
    narration: He presses every switch on the wall. Nothing on the ceiling answers.
    zoomFrom: 1
    zoomTo: 1.08
    zoomDuration: 6
    hardCut: 0
    silenceBefore: 0
  - image: {fileID: -3457971734771721935, guid: 20aa1f7a7ee4748d88847005c829e2b5, type: 3}
    narration: Inside his locker, a first aid kit and one handheld lamp. He takes the lamp.
    zoomFrom: 1
    zoomTo: 1.12
    zoomDuration: 6
    hardCut: 0
    silenceBefore: 0
  nextSceneName: IntroCinematic
